# Copy to .env (untracked) and fill in your dfbf.dk session cookie.
# Get it from your browser devtools: copy the full Cookie header sent to
# https://dfbf.dk/wp-admin/admin-ajax.php (the request the information portal makes).
# The session expires periodically — refresh this when fetch-curve starts failing.
DFBF_COOKIE="euCookie=set; PHPSESSID=...; wordpress_logged_in_...=..."
